# PostgreSQL connection (the app user; RLS policies apply to it)
DATABASE_URL="postgresql://careflow:careflow@localhost:5432/careflow?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:4200"

# AI providers (optional - the AI module disables itself when no key is set)
AI_PROVIDER="claude"           # claude | gemini
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"

# Field-level encryption key for sensitive patient fields (32 bytes, base64)
FIELD_ENCRYPTION_KEY=""

# ── Messaging providers (patient communications) ──────────────────────────────
# MESSAGING_SMS_PROVIDER: twilio | log   (log = print to server log, for development)
MESSAGING_SMS_PROVIDER="log"
MESSAGING_WHATSAPP_PROVIDER="log"      # twilio | log
MESSAGING_EMAIL_PROVIDER="log"         # smtp | log
MESSAGING_DEFAULT_COUNTRY_CODE="966"   # used when a local number (05xxxxxxxx) is given
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""                     # e.g. +15005550006
TWILIO_WHATSAPP_FROM=""                # e.g. whatsapp:+14155238886
# Without TWILIO_AUTH_TOKEN every Twilio webhook is rejected (403). For local development
# only, TWILIO_WEBHOOK_INSECURE=1 accepts UNSIGNED webhooks from loopback (127.0.0.1 / ::1).
# Ignored when NODE_ENV=production.
TWILIO_WEBHOOK_INSECURE=""
# Inbound "1"/"2" replies apply only to a reminder/booking message sent within this many days
MESSAGING_REPLY_WINDOW_DAYS=7
SMTP_URL=""                            # e.g. smtps://user:pass@smtp.example.com:465
SMTP_FROM="CareFlow <no-reply@example.com>"
# Public base URL of the API, used to build webhook URLs and portal links
PUBLIC_API_URL="http://localhost:3000"
PUBLIC_WEB_URL="http://localhost:4200"

# ── Patient portal ────────────────────────────────────────────────────────────
PORTAL_JWT_EXPIRES_IN="12h"
PORTAL_OTP_TTL_MINUTES=5
PORTAL_OTP_MAX_ATTEMPTS=5
PORTAL_OTP_REQUEST_LIMIT="3"              # codes per (clinic, phone) per window
PORTAL_OTP_REQUEST_WINDOW_MINUTES=15
PORTAL_OTP_COOLDOWN_SECONDS="60"          # minimum gap between two codes for the same phone
PORTAL_OTP_FAILURE_BUDGET="10"            # failed verifies per phone (all codes) before a lock-out ...
PORTAL_OTP_FAILURE_WINDOW_MINUTES="60"    # ... for this window
PORTAL_OTP_MIN_LATENCY_MS="400"           # request-otp / failed verify responses are padded to this
# Per clinic (clinic.settings JSON): portalMaxActiveBookings (default 3), portalBookingHorizonDays (default 90)

# ── Embeddings for semantic record search (Gemini text-embedding; needs GEMINI_API_KEY)
EMBEDDING_PROVIDER="gemini"           # gemini | none
EMBEDDING_MODEL="gemini-embedding-001"
