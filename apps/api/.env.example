# PostgreSQL connection (the app user; RLS policies apply to it)
DATABASE_URL="postgresql://careflow:careflow@localhost:5432/careflow?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:4200"

# AI providers (optional - the AI module disables itself when no key is set)
AI_PROVIDER="claude"           # claude | gemini
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"

# Field-level encryption key for sensitive patient fields (32 bytes, base64)
FIELD_ENCRYPTION_KEY=""
