// CareFlow data model.
//
// Multi-tenancy: every clinic-scoped table carries `clinic_id` and is protected by
// PostgreSQL Row-Level Security (see the migration SQL). The application sets
// `app.current_clinic_id` per request/transaction; queries without it return no rows.
//
// Naming: tables and columns are snake_case in PostgreSQL (via @map/@@map) so raw SQL
// (RLS policies, exclusion constraints) reads naturally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy & identity ─────────────────────────────

model Clinic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  phone     String?
  email     String?
  address   String?
  currency  String   @default("USD")
  settings  Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships    ClinicMembership[]
  doctors        Doctor[]
  patients       Patient[]
  appointments   Appointment[]
  encounters     Encounter[]
  invoices       Invoice[]
  services       Service[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  aiInteractions AiInteraction[]
  resources      Resource[]
  series         AppointmentSeries[]
  waitlist       WaitlistEntry[]

  @@map("clinics")
}

/// Global identity. A user may belong to several clinics through ClinicMembership.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  /// UI language preference: "ar" | "en". Null = clinic default.
  locale       String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships   ClinicMembership[]
  refreshTokens RefreshToken[]
  doctorProfile Doctor[]
  notifications Notification[]

  @@map("users")
}

enum Role {
  OWNER
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  ACCOUNTANT
}

/// Links a user to a clinic with a role. `extraPermissions` grants permissions beyond the role.
model ClinicMembership {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String   @map("clinic_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  role             Role
  extraPermissions String[] @default([]) @map("extra_permissions")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([userId])
  @@map("clinic_memberships")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────────────── Doctors ─────────────────────────────────

model Doctor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  title         String?
  specialty     String
  licenseNumber String?  @map("license_number")
  phone         String?
  email         String?
  color         String   @default("#2563eb")
  bio           String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability  DoctorAvailability[]
  timeOff       DoctorTimeOff[]
  appointments  Appointment[]
  encounters    Encounter[]
  prescriptions Prescription[]

  @@index([clinicId])
  @@index([clinicId, userId])
  @@map("doctors")
}

/// Weekly recurring working hours. weekday: 0 = Sunday … 6 = Saturday. Times are "HH:mm" in clinic timezone.
model DoctorAvailability {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String  @map("clinic_id") @db.Uuid
  doctorId    String  @map("doctor_id") @db.Uuid
  weekday     Int
  startTime   String  @map("start_time")
  endTime     String  @map("end_time")
  slotMinutes Int     @default(30) @map("slot_minutes")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId])
  @@map("doctor_availability")
}

model DoctorTimeOff {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String   @map("clinic_id") @db.Uuid
  doctorId String   @map("doctor_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt   DateTime @map("ends_at") @db.Timestamptz
  reason   String?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, startsAt])
  @@map("doctor_time_off")
}

// ───────────────────────────────── Patients ─────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model Patient {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid
  mrn              String // medical record number, unique per clinic
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           Gender    @default(UNKNOWN)
  phone            String?
  email            String?
  address          String?
  /// Encrypted at the application layer (AES-256-GCM). Never returned raw by list endpoints.
  nationalIdEnc    String?   @map("national_id_enc")
  bloodType        String?   @map("blood_type")
  emergencyContact Json?     @map("emergency_contact")
  notes            String?
  /// Patient portal: self-service access via phone OTP. Disabled by default.
  portalEnabled    Boolean   @default(false) @map("portal_enabled")
  /// Preferred language for messages and the portal: "ar" | "en".
  locale           String?
  /// Normalised, searchable text (Arabic/Latin folding) maintained by a DB trigger - see migration.
  searchText       String?   @map("search_text")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consents       PatientConsent[]
  messages       Message[]
  allergies      Allergy[]
  appointments   Appointment[]
  encounters     Encounter[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  accessLogs     RecordAccessLog[]
  aiInteractions AiInteraction[]

  @@unique([clinicId, mrn])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, phone])
  @@map("patients")
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

model Allergy {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String          @map("clinic_id") @db.Uuid
  patientId String          @map("patient_id") @db.Uuid
  substance String
  reaction  String?
  severity  AllergySeverity @default(MODERATE)
  notedAt   DateTime        @default(now()) @map("noted_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("allergies")
}

// ─────────────────────────────── Appointments ───────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  CHECKUP
  EMERGENCY
}

/// Overlap protection: a GiST exclusion constraint on (doctor_id, tstzrange(starts_at, ends_at))
/// for active statuses is created in the migration SQL - the DB is the final arbiter.
model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String            @map("clinic_id") @db.Uuid
  doctorId         String            @map("doctor_id") @db.Uuid
  patientId        String            @map("patient_id") @db.Uuid
  startsAt         DateTime          @map("starts_at") @db.Timestamptz
  endsAt           DateTime          @map("ends_at") @db.Timestamptz
  status           AppointmentStatus @default(SCHEDULED)
  type             AppointmentType   @default(CONSULTATION)
  reason           String?
  notes            String?
  cancellationNote String?           @map("cancellation_note")
  createdById      String?           @map("created_by_id") @db.Uuid
  /// Optimistic concurrency: every update must carry the version it read.
  version          Int               @default(1)
  /// Client-supplied key making POST /appointments safe to retry.
  idempotencyKey   String?           @map("idempotency_key")
  /// Set when the slot is tentatively held (waitlist offer); auto-cancelled on expiry.
  holdExpiresAt    DateTime?         @map("hold_expires_at") @db.Timestamptz
  /// Predicted probability of no-show (0..1) from the clinic's model.
  noShowRisk       Float?            @map("no_show_risk")
  seriesId         String?           @map("series_id") @db.Uuid
  occurrenceIndex  Int?              @map("occurrence_index")
  /// True when this occurrence was moved/edited away from its series rule.
  isException      Boolean           @default(false) @map("is_exception")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor           Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  series           AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  encounter        Encounter?
  invoices         Invoice[]
  resourceBookings ResourceBooking[]
  reminders        Reminder[]
  waitlistEntries  WaitlistEntry[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, doctorId, startsAt])
  @@index([clinicId, patientId, startsAt])
  @@index([clinicId, startsAt])
  @@index([clinicId, seriesId])
  @@index([holdExpiresAt])
  @@map("appointments")
}

// ─────────────────────────────── Medical records ───────────────────────────────

enum EncounterStatus {
  DRAFT
  SIGNED
  AMENDED
}

/// A clinical visit, documented in SOAP format.
model Encounter {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId       String          @map("clinic_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  doctorId       String          @map("doctor_id") @db.Uuid
  appointmentId  String?         @unique @map("appointment_id") @db.Uuid
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz
  chiefComplaint String?         @map("chief_complaint")
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  vitals         Json?
  status         EncounterStatus @default(DRAFT)
  signedAt       DateTime?       @map("signed_at") @db.Timestamptz
  /// Full-text search vector over the SOAP fields, maintained by a DB trigger (see migration).
  searchVector   Unsupported("tsvector")? @map("search_vector")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  invoices      Invoice[]
  embedding     EncounterEmbedding?

  @@index([clinicId, patientId, occurredAt])
  @@index([clinicId, doctorId, occurredAt])
  @@map("encounters")
}

model Diagnosis {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String  @map("clinic_id") @db.Uuid
  encounterId String  @map("encounter_id") @db.Uuid
  code        String // ICD-10
  description String
  isPrimary   Boolean @default(false) @map("is_primary")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([clinicId, encounterId])
  @@map("diagnoses")
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

model Prescription {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String             @map("clinic_id") @db.Uuid
  encounterId  String             @map("encounter_id") @db.Uuid
  patientId    String             @map("patient_id") @db.Uuid
  doctorId     String             @map("doctor_id") @db.Uuid
  medication   String
  dosage       String
  frequency    String
  durationDays Int?               @map("duration_days")
  instructions String?
  status       PrescriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, status])
  @@map("prescriptions")
}

/// Who looked at a patient's record and when. Append-only; required for sensitive-data accountability.
model RecordAccessLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  encounterId String?  @map("encounter_id") @db.Uuid
  action      String // VIEW_PROFILE | VIEW_ENCOUNTER | EXPORT | AI_SUMMARY ...
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, userId, createdAt])
  @@map("record_access_logs")
}

// ──────────────────────────────────── Billing ────────────────────────────────────

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  code            String
  name            String
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(30) @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  items  InvoiceItem[]

  @@unique([clinicId, code])
  @@map("services")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId      String        @map("clinic_id") @db.Uuid
  patientId     String        @map("patient_id") @db.Uuid
  appointmentId String?       @map("appointment_id") @db.Uuid
  encounterId   String?       @map("encounter_id") @db.Uuid
  number        String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz
  dueAt         DateTime?     @map("due_at") @db.Timestamptz
  notes         String?
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  encounter   Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String  @map("clinic_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  serviceId   String? @map("service_id") @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([clinicId, invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String        @map("clinic_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  paidAt       DateTime      @default(now()) @map("paid_at") @db.Timestamptz
  receivedById String?       @map("received_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId, invoiceId])
  @@map("payments")
}

// ──────────────────────────────── Notifications ────────────────────────────────

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  PATIENT_CHECKED_IN
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  AI_RESULT_READY
  SYSTEM
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String           @map("clinic_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId, userId, readAt, createdAt])
  @@map("notifications")
}

// ──────────────────────────────────── Audit ────────────────────────────────────

/// Append-only. Written automatically by the audit interceptor for every mutation.
/// UPDATE/DELETE are revoked at the database level in the migration.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String?  @map("clinic_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  action      String // e.g. appointments.create
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  method      String
  path        String
  statusCode  Int      @map("status_code")
  requestBody Json?    @map("request_body")
  diff        Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String   @map("request_id")
  durationMs  Int      @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ────────────────────────────────────── AI ──────────────────────────────────────

enum AiFeature {
  PATIENT_SUMMARY
  SOAP_NOTE
}

enum AiInteractionStatus {
  GENERATED
  APPROVED
  REJECTED
  FAILED
}

/// Every AI call is recorded: who asked, what feature, which provider/model, and whether a human approved the output.
model AiInteraction {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String              @map("clinic_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  patientId        String?             @map("patient_id") @db.Uuid
  encounterId      String?             @map("encounter_id") @db.Uuid
  feature          AiFeature
  provider         String
  model            String
  inputHash        String              @map("input_hash")
  output           String?
  structuredOutput Json?               @map("structured_output")
  status           AiInteractionStatus @default(GENERATED)
  error            String?
  inputTokens      Int?                @map("input_tokens")
  outputTokens     Int?                @map("output_tokens")
  latencyMs        Int?                @map("latency_ms")
  reviewedById     String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?           @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, userId, createdAt])
  @@map("ai_interactions")
}

// ───────────────────────────── Scheduling engine ─────────────────────────────

enum ResourceType {
  ROOM
  EQUIPMENT
  STAFF
  OTHER
}

/// A bookable non-doctor resource (room, device). Each has its own calendar.
model Resource {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String       @map("clinic_id") @db.Uuid
  name      String
  type      ResourceType @default(ROOM)
  color     String       @default("#6b7280")
  /// Optional: which appointment types require this resource by default.
  notes     String?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  clinic   Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  bookings ResourceBooking[]

  @@unique([clinicId, name])
  @@map("resources")
}

/// One row per (appointment, resource). Times are duplicated from the appointment so a
/// GiST exclusion constraint (migration SQL) can forbid double-booking a resource.
model ResourceBooking {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  resourceId    String   @map("resource_id") @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  startsAt      DateTime @map("starts_at") @db.Timestamptz
  endsAt        DateTime @map("ends_at") @db.Timestamptz
  /// Mirrors Appointment.status; inactive bookings are excluded from the constraint.
  active        Boolean  @default(true)

  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, resourceId])
  @@index([clinicId, resourceId, startsAt])
  @@map("resource_bookings")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum SeriesStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A recurring appointment rule (RRULE-like). Occurrences are materialised as Appointment rows.
model AppointmentSeries {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId        String              @map("clinic_id") @db.Uuid
  doctorId        String              @map("doctor_id") @db.Uuid
  patientId       String              @map("patient_id") @db.Uuid
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  /// For WEEKLY: 0 = Sunday … 6 = Saturday.
  byWeekday       Int[]               @default([]) @map("by_weekday")
  /// For MONTHLY: day of month (1..31).
  byMonthDay      Int?                @map("by_month_day")
  startsOn        DateTime            @map("starts_on") @db.Date
  /// "HH:mm" in the clinic timezone.
  startTime       String              @map("start_time")
  durationMinutes Int                 @map("duration_minutes")
  count           Int?
  until           DateTime?           @db.Date
  type            AppointmentType     @default(FOLLOW_UP)
  reason          String?
  status          SeriesStatus        @default(ACTIVE)
  createdById     String?             @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId, patientId])
  @@index([clinicId, doctorId])
  @@map("appointment_series")
}

enum WaitlistPriority {
  ROUTINE
  SOON
  URGENT
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

/// A patient waiting for an earlier/any slot. Backfilled automatically when slots free up.
model WaitlistEntry {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String           @map("clinic_id") @db.Uuid
  patientId        String           @map("patient_id") @db.Uuid
  /// Either a specific doctor or any doctor with the given specialty.
  doctorId         String?          @map("doctor_id") @db.Uuid
  specialty        String?
  durationMinutes  Int              @default(30) @map("duration_minutes")
  priority         WaitlistPriority @default(ROUTINE)
  earliestAt       DateTime         @default(now()) @map("earliest_at") @db.Timestamptz
  latestAt         DateTime?        @map("latest_at") @db.Timestamptz
  /// Acceptable windows: [{ weekday: 0-6, startTime: "HH:mm", endTime: "HH:mm" }]; empty = any time.
  preferredWindows Json             @default("[]") @map("preferred_windows")
  type             AppointmentType  @default(CONSULTATION)
  notes            String?
  status           WaitlistStatus   @default(WAITING)
  /// Slot currently offered to the patient (held appointment) and its expiry.
  offeredAppointmentId String?      @map("offered_appointment_id") @db.Uuid
  offerExpiresAt   DateTime?        @map("offer_expires_at") @db.Timestamptz
  offerCount       Int              @default(0) @map("offer_count")
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  clinic             Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  offeredAppointment Appointment? @relation(fields: [offeredAppointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId, status, priority, createdAt])
  @@index([clinicId, patientId])
  @@map("waitlist_entries")
}

enum ReminderChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

/// Outbox for appointment reminders, processed by a periodic worker.
model Reminder {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId      String          @map("clinic_id") @db.Uuid
  appointmentId String          @map("appointment_id") @db.Uuid
  channel       ReminderChannel @default(IN_APP)
  scheduledFor  DateTime        @map("scheduled_for") @db.Timestamptz
  status        ReminderStatus  @default(PENDING)
  attempts      Int             @default(0)
  lastError     String?         @map("last_error")
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, channel, scheduledFor])
  @@index([status, scheduledFor])
  @@map("reminders")
}

/// Per-clinic no-show prediction model (logistic regression weights), retrained periodically.
model NoShowModel {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId   String   @unique @map("clinic_id") @db.Uuid
  /// { bias: number, weights: Record<feature, number>, means/scales for normalisation }
  parameters Json
  sampleSize Int      @map("sample_size")
  /// Training metrics, e.g. { accuracy, auc, positiveRate }
  metrics    Json?
  trainedAt  DateTime @default(now()) @map("trained_at") @db.Timestamptz

  @@map("no_show_models")
}

enum ProposalStatus {
  PENDING
  APPLIED
  PARTIALLY_APPLIED
  DISMISSED
}

/// A computed plan to move displaced appointments (e.g. after doctor time off) into free slots.
model RescheduleProposal {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId                 String         @map("clinic_id") @db.Uuid
  cause                    String
  doctorTimeOffId          String?        @map("doctor_time_off_id") @db.Uuid
  /// [{ appointmentId, patientName, from, to, fromDoctorId, toDoctorId, displacementMinutes, applied, error? }]
  items                    Json
  unresolvedAppointmentIds String[]       @default([]) @map("unresolved_appointment_ids")
  totalDisplacementMinutes Int            @default(0) @map("total_displacement_minutes")
  status                   ProposalStatus @default(PENDING)
  createdById              String?        @map("created_by_id") @db.Uuid
  appliedById              String?        @map("applied_by_id") @db.Uuid
  appliedAt                DateTime?      @map("applied_at") @db.Timestamptz
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([clinicId, status, createdAt])
  @@map("reschedule_proposals")
}

// ───────────────────────── Search, portal & messaging ─────────────────────────

/// Vector embedding of an encounter's clinical text for semantic search ("ask the record").
/// The `embedding` column is pgvector `vector(768)`; written with raw SQL by the AI module.
model EncounterEmbedding {
  encounterId String   @id @map("encounter_id") @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  model       String
  /// sha256 of the text that was embedded, to skip re-embedding unchanged encounters.
  contentHash String   @map("content_hash")
  embedding   Unsupported("vector(768)")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("encounter_embeddings")
}

enum OtpPurpose {
  PORTAL_LOGIN
}

/// One-time codes for patient portal login. Codes are stored hashed; rows are short-lived.
model OtpCode {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId   String     @map("clinic_id") @db.Uuid
  phone      String
  purpose    OtpPurpose @default(PORTAL_LOGIN)
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([clinicId, phone, createdAt])
  @@map("otp_codes")
}

/// Record of a patient accepting a policy (privacy, treatment, messaging) at a given version.
model PatientConsent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId   String   @map("clinic_id") @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  type       String // PRIVACY | TREATMENT | MESSAGING | ...
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, type, version])
  @@index([clinicId, patientId])
  @@map("patient_consents")
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

/// Every message exchanged with a patient over an external channel (audit + two-way replies).
model Message {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId          String           @map("clinic_id") @db.Uuid
  patientId         String?          @map("patient_id") @db.Uuid
  appointmentId     String?          @map("appointment_id") @db.Uuid
  channel           MessageChannel
  direction         MessageDirection
  /// Phone number or email address.
  address           String
  body              String
  /// Template key when generated by the system, e.g. appointment.reminder.
  template          String?
  status            MessageStatus    @default(QUEUED)
  provider          String?
  providerMessageId String?          @map("provider_message_id")
  error             String?
  /// For inbound replies: which outbound message/appointment this answers, and the parsed intent.
  inReplyToId       String?          @map("in_reply_to_id") @db.Uuid
  intent            String? // CONFIRM | CANCEL | UNKNOWN
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, appointmentId])
  @@index([providerMessageId])
  @@map("messages")
}
